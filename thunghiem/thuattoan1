#include <iostream>

using namespace std;;

bool nguyento(unsigned int n){
	if(n < 2){
		return false;
	}
		for(int i = 2; i <= sqrt(n); i++){
			if(n % i == 0)
			{
				return false;
			}
		}
	return true;
}
int main(){
	unsigned int n;
	cin >> n;
	
	if nguyento(n){
		cout << "nguyen to";
	}else{
		cout << "k phai nguyen to";
	}
	return 0;
}
